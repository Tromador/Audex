{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuditRunPhase": {
      "enum": [
        "created",
        "snapshot_bound",
        "reviewing",
        "reporting",
        "reconciling",
        "completed",
        "completed_with_failures",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "properties": {
    "phase": {
      "$ref": "#/definitions/AuditRunPhase"
    },
    "revision": {
      "format": "int64",
      "type": "integer"
    },
    "runId": {
      "type": "string"
    }
  },
  "required": [
    "phase",
    "revision",
    "runId"
  ],
  "title": "AuditProgressNotification",
  "type": "object"
}