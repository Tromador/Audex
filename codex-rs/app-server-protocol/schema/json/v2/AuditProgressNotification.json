{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuditAttemptProgress": {
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "outputSequence": {
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "assignmentId",
        "outputSequence",
        "revision"
      ],
      "type": "object"
    },
    "AuditRunPhase": {
      "enum": [
        "created",
        "snapshot_bound",
        "reviewing",
        "reporting",
        "reconciling",
        "completed",
        "completed_with_failures",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "properties": {
    "attempts": {
      "default": [],
      "items": {
        "$ref": "#/definitions/AuditAttemptProgress"
      },
      "type": "array"
    },
    "phase": {
      "$ref": "#/definitions/AuditRunPhase"
    },
    "revision": {
      "format": "int64",
      "type": "integer"
    },
    "runId": {
      "type": "string"
    }
  },
  "required": [
    "phase",
    "revision",
    "runId"
  ],
  "title": "AuditProgressNotification",
  "type": "object"
}