{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuditActivityEntry": {
      "properties": {
        "itemId": {
          "type": "string"
        },
        "kind": {
          "description": "Assistant text, source-tool activity and status remain distinct.",
          "type": "string"
        },
        "payload": {
          "description": "Exact retained public material. Activity is unvalidated, including JSON.",
          "type": "string"
        },
        "payloadDigest": {
          "type": "string"
        },
        "sequence": {
          "format": "int64",
          "type": "integer"
        },
        "sessionId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "kind",
        "payload",
        "payloadDigest",
        "sequence",
        "sessionId",
        "turnId"
      ],
      "type": "object"
    },
    "AuditAttemptView": {
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "assignmentState": {
          "type": "string"
        },
        "attemptOrdinal": {
          "format": "int64",
          "type": "integer"
        },
        "authenticationRoute": {
          "description": "Uses the retained native route; this does not claim an API/subscription billing amount.",
          "type": "string"
        },
        "captureFailure": {
          "type": [
            "string",
            "null"
          ]
        },
        "captureGap": {
          "type": [
            "string",
            "null"
          ]
        },
        "captureTruncated": {
          "type": "boolean"
        },
        "completed": {
          "description": "True only for a canonical validated result, never inferred from activity.",
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        },
        "disposition": {
          "description": "Contribution disposition is independent of execution certainty.",
          "type": "string"
        },
        "executionAdapter": {
          "$ref": "#/definitions/AuditExecutionAdapter"
        },
        "expectedServedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "localExecution": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuditLocalExecution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Live local cleanup receipts, independent of the frozen contribution and remote billing."
        },
        "model": {
          "description": "Requested selection, retained for compatibility.",
          "type": "string"
        },
        "modelEvidence": {
          "description": "Retained per-generation evidence, including failures; reads never refresh configuration.",
          "items": {
            "$ref": "#/definitions/AuditGenerationIdentity"
          },
          "type": "array"
        },
        "operationId": {
          "type": "string"
        },
        "operationState": {
          "type": "string"
        },
        "outputCutoff": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "outputSequence": {
          "format": "int64",
          "type": "integer"
        },
        "ownerGeneration": {
          "format": "int64",
          "type": "integer"
        },
        "possibleOverlap": {
          "type": "boolean"
        },
        "provider": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestedModel": {
          "type": "string"
        },
        "resolvedModel": {
          "type": "string"
        },
        "retryEligible": {
          "type": "boolean"
        },
        "reviewerId": {
          "type": "string"
        },
        "reviewerOrdinal": {
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "assignmentId",
        "assignmentState",
        "attemptOrdinal",
        "authenticationRoute",
        "captureTruncated",
        "completed",
        "current",
        "disposition",
        "executionAdapter",
        "model",
        "modelEvidence",
        "operationId",
        "operationState",
        "outputSequence",
        "ownerGeneration",
        "possibleOverlap",
        "provider",
        "requestedModel",
        "resolvedModel",
        "retryEligible",
        "reviewerId",
        "reviewerOrdinal",
        "revision",
        "runId",
        "snapshotId"
      ],
      "type": "object"
    },
    "AuditExecutionAdapter": {
      "description": "Execution mechanism is distinct from the configured provider and authentication route.",
      "enum": [
        "native",
        "claude_client"
      ],
      "type": "string"
    },
    "AuditGenerationIdentity": {
      "properties": {
        "evidenceScope": {
          "description": "Connection observations cannot establish per-generation attribution.",
          "type": [
            "string",
            "null"
          ]
        },
        "expectedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "state",
        "transport"
      ],
      "type": "object"
    },
    "AuditLocalExecution": {
      "properties": {
        "cleanupFinishedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "stopConfirmedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "stopRequestedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  },
  "properties": {
    "attempt": {
      "$ref": "#/definitions/AuditAttemptView"
    },
    "entries": {
      "items": {
        "$ref": "#/definitions/AuditActivityEntry"
      },
      "type": "array"
    },
    "nextSequence": {
      "format": "int64",
      "type": "integer"
    },
    "rawResult": {
      "description": "The original terminal response, if retained; invalid JSON stays invalid.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "attempt",
    "entries",
    "nextSequence"
  ],
  "title": "AuditAttemptReadResponse",
  "type": "object"
}