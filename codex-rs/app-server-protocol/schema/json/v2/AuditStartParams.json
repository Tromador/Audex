{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AuditExecutionAdapter": {
      "description": "Execution mechanism is distinct from the configured provider and authentication route.",
      "enum": [
        "native"
      ],
      "type": "string"
    },
    "AuditReviewerSelection": {
      "additionalProperties": false,
      "properties": {
        "executionAdapter": {
          "allOf": [
            {
              "$ref": "#/definitions/AuditExecutionAdapter"
            }
          ],
          "default": "native"
        },
        "expectedServedModel": {
          "description": "Expected authoritative identity; omission requires exact resolved-model matching.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "model",
        "provider"
      ],
      "type": "object"
    },
    "AuditScheduling": {
      "enum": [
        "automatic",
        "sequential"
      ],
      "type": "string"
    },
    "AuditSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "snippet"
              ],
              "title": "SnippetAuditSourceType",
              "type": "string"
            }
          },
          "required": [
            "content",
            "name",
            "type"
          ],
          "title": "SnippetAuditSource",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "enum": [
                "file"
              ],
              "title": "FileAuditSourceType",
              "type": "string"
            }
          },
          "required": [
            "name",
            "path",
            "type"
          ],
          "title": "FileAuditSource",
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "agentsEvidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "audexGuidance": {
      "type": [
        "string",
        "null"
      ]
    },
    "brief": {
      "type": "string"
    },
    "expectedServedModel": {
      "description": "Explicitly qualified served-model alias for the singular selection.",
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoningEffort": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestKey": {
      "type": "string"
    },
    "reviewers": {
      "description": "Ordered native roster. Mutually exclusive with the singular selection.",
      "items": {
        "$ref": "#/definitions/AuditReviewerSelection"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "scheduling": {
      "allOf": [
        {
          "$ref": "#/definitions/AuditScheduling"
        }
      ],
      "default": "automatic"
    },
    "source": {
      "$ref": "#/definitions/AuditSource"
    }
  },
  "required": [
    "brief",
    "requestKey",
    "source"
  ],
  "title": "AuditStartParams",
  "type": "object"
}