{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuditAttemptView": {
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "assignmentState": {
          "type": "string"
        },
        "attemptOrdinal": {
          "format": "int64",
          "type": "integer"
        },
        "authenticationRoute": {
          "description": "Uses the retained native route; this does not claim an API/subscription billing amount.",
          "type": "string"
        },
        "captureFailure": {
          "type": [
            "string",
            "null"
          ]
        },
        "captureGap": {
          "type": [
            "string",
            "null"
          ]
        },
        "captureTruncated": {
          "type": "boolean"
        },
        "completed": {
          "description": "An authoritative completed opinion, independent of structured extraction. Never inferred from activity, process exit alone or reviewer identity claims.",
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        },
        "disposition": {
          "description": "Contribution disposition is independent of execution certainty.",
          "type": "string"
        },
        "executionAdapter": {
          "$ref": "#/definitions/AuditExecutionAdapter"
        },
        "expectedServedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuditResultExtraction"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent for historical results predating the shared extraction contract."
        },
        "findingCount": {
          "default": null,
          "description": "Retained structured finding count; absent until the attempt completed.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "localExecution": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuditLocalExecution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Live local cleanup receipts, independent of the frozen contribution and remote billing."
        },
        "model": {
          "description": "Requested selection, retained for compatibility.",
          "type": "string"
        },
        "modelEvidence": {
          "description": "Retained per-generation evidence, including failures; reads never refresh configuration.",
          "items": {
            "$ref": "#/definitions/AuditGenerationIdentity"
          },
          "type": "array"
        },
        "operationId": {
          "type": "string"
        },
        "operationState": {
          "type": "string"
        },
        "outputCutoff": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "outputSequence": {
          "format": "int64",
          "type": "integer"
        },
        "ownerGeneration": {
          "format": "int64",
          "type": "integer"
        },
        "possibleOverlap": {
          "type": "boolean"
        },
        "provider": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "recoveryStatus": {
          "description": "Recovery decision for this attempt; ordinary client retries are separate.",
          "type": [
            "string",
            "null"
          ]
        },
        "requestedModel": {
          "type": "string"
        },
        "resolvedModel": {
          "type": "string"
        },
        "retryEligible": {
          "type": "boolean"
        },
        "reviewerId": {
          "type": "string"
        },
        "reviewerOrdinal": {
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "assignmentId",
        "assignmentState",
        "attemptOrdinal",
        "authenticationRoute",
        "captureTruncated",
        "completed",
        "current",
        "disposition",
        "executionAdapter",
        "model",
        "modelEvidence",
        "operationId",
        "operationState",
        "outputSequence",
        "ownerGeneration",
        "possibleOverlap",
        "provider",
        "requestedModel",
        "resolvedModel",
        "retryEligible",
        "reviewerId",
        "reviewerOrdinal",
        "revision",
        "runId",
        "snapshotId"
      ],
      "type": "object"
    },
    "AuditExecutionAdapter": {
      "description": "Execution mechanism is distinct from the configured provider and authentication route.",
      "enum": [
        "native",
        "claude_client"
      ],
      "type": "string"
    },
    "AuditExtractionStatus": {
      "enum": [
        "validated_structured",
        "deterministically_normalised",
        "unstructured_opinion"
      ],
      "type": "string"
    },
    "AuditGenerationIdentity": {
      "properties": {
        "evidenceScope": {
          "description": "Connection observations cannot establish per-generation attribution.",
          "type": [
            "string",
            "null"
          ]
        },
        "expectedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "state",
        "transport"
      ],
      "type": "object"
    },
    "AuditLocalExecution": {
      "properties": {
        "cleanupFinishedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "stopConfirmedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "stopRequestedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "AuditResultExtraction": {
      "additionalProperties": false,
      "description": "Versioned deterministic extraction facts; completion provenance stays on the attempt.",
      "properties": {
        "parseDigest": {
          "type": "string"
        },
        "rawDigest": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/AuditExtractionStatus"
        },
        "transformations": {
          "items": {
            "$ref": "#/definitions/AuditResultTransformation"
          },
          "type": "array"
        },
        "validationError": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "parseDigest",
        "rawDigest",
        "status",
        "transformations",
        "version"
      ],
      "type": "object"
    },
    "AuditResultTransformation": {
      "enum": [
        "utf8_bom",
        "markdown_json_fence"
      ],
      "type": "string"
    }
  },
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/definitions/AuditAttemptView"
      },
      "type": "array"
    }
  },
  "required": [
    "attempts"
  ],
  "title": "AuditAttemptsResponse",
  "type": "object"
}