{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuditOperationState": {
      "description": "Durable operation state; `unknown` is distinct from a failed review.",
      "enum": [
        "planned",
        "dispatching",
        "accepted",
        "observed_terminal",
        "committed",
        "failed",
        "unknown"
      ],
      "type": "string"
    },
    "AuditRunPhase": {
      "enum": [
        "created",
        "snapshot_bound",
        "reviewing",
        "reporting",
        "reconciling",
        "completed",
        "completed_with_failures",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "AuditRunView": {
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "cancellationRequested": {
          "type": "boolean"
        },
        "capacityReleased": {
          "description": "The operator explicitly released capacity. This is not terminal evidence.",
          "type": "boolean"
        },
        "observationPending": {
          "description": "A retained observation issue remains unresolved. This is non-terminal: the daemon continues observing the original operation, without resampling.",
          "type": "boolean"
        },
        "operationState": {
          "$ref": "#/definitions/AuditOperationState"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/definitions/AuditRunPhase"
        },
        "rawResult": {
          "description": "Exact retained response, including invalid JSON, when a bounded result was received.",
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "assignmentId",
        "cancellationRequested",
        "capacityReleased",
        "observationPending",
        "operationState",
        "phase",
        "revision",
        "runId",
        "snapshotId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocolVersion": {
      "description": "Required even for an empty list, so clients can check before submitting work.",
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "runs": {
      "description": "Newest-first metadata summaries. Results and reports are absent; audit/read retrieves those artefacts with strict integrity verification.",
      "items": {
        "$ref": "#/definitions/AuditRunView"
      },
      "type": "array"
    }
  },
  "required": [
    "protocolVersion",
    "runs"
  ],
  "title": "AuditListResponse",
  "type": "object"
}