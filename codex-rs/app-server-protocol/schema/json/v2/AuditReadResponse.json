{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuditAttemptView": {
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "assignmentState": {
          "type": "string"
        },
        "attemptOrdinal": {
          "format": "int64",
          "type": "integer"
        },
        "authenticationRoute": {
          "description": "Uses the retained native route; this does not claim an API/subscription billing amount.",
          "type": "string"
        },
        "captureFailure": {
          "type": [
            "string",
            "null"
          ]
        },
        "captureGap": {
          "type": [
            "string",
            "null"
          ]
        },
        "captureTruncated": {
          "type": "boolean"
        },
        "completed": {
          "description": "An authoritative completed opinion, independent of structured extraction. Never inferred from activity, process exit alone or reviewer identity claims.",
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        },
        "disposition": {
          "description": "Contribution disposition is independent of execution certainty.",
          "type": "string"
        },
        "executionAdapter": {
          "$ref": "#/definitions/AuditExecutionAdapter"
        },
        "expectedServedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuditResultExtraction"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent for historical results predating the shared extraction contract."
        },
        "localExecution": {
          "anyOf": [
            {
              "$ref": "#/definitions/AuditLocalExecution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Live local cleanup receipts, independent of the frozen contribution and remote billing."
        },
        "model": {
          "description": "Requested selection, retained for compatibility.",
          "type": "string"
        },
        "modelEvidence": {
          "description": "Retained per-generation evidence, including failures; reads never refresh configuration.",
          "items": {
            "$ref": "#/definitions/AuditGenerationIdentity"
          },
          "type": "array"
        },
        "operationId": {
          "type": "string"
        },
        "operationState": {
          "type": "string"
        },
        "outputCutoff": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "outputSequence": {
          "format": "int64",
          "type": "integer"
        },
        "ownerGeneration": {
          "format": "int64",
          "type": "integer"
        },
        "possibleOverlap": {
          "type": "boolean"
        },
        "provider": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestedModel": {
          "type": "string"
        },
        "resolvedModel": {
          "type": "string"
        },
        "retryEligible": {
          "type": "boolean"
        },
        "reviewerId": {
          "type": "string"
        },
        "reviewerOrdinal": {
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "assignmentId",
        "assignmentState",
        "attemptOrdinal",
        "authenticationRoute",
        "captureTruncated",
        "completed",
        "current",
        "disposition",
        "executionAdapter",
        "model",
        "modelEvidence",
        "operationId",
        "operationState",
        "outputSequence",
        "ownerGeneration",
        "possibleOverlap",
        "provider",
        "requestedModel",
        "resolvedModel",
        "retryEligible",
        "reviewerId",
        "reviewerOrdinal",
        "revision",
        "runId",
        "snapshotId"
      ],
      "type": "object"
    },
    "AuditCollectionView": {
      "properties": {
        "completedCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "excludedCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "outstandingCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "ready": {
          "type": "boolean"
        },
        "reviewerCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "scheduling": {
          "$ref": "#/definitions/AuditScheduling"
        }
      },
      "required": [
        "completedCount",
        "excludedCount",
        "outstandingCount",
        "ready",
        "reviewerCount",
        "scheduling"
      ],
      "type": "object"
    },
    "AuditExecutionAdapter": {
      "description": "Execution mechanism is distinct from the configured provider and authentication route.",
      "enum": [
        "native",
        "claude_client"
      ],
      "type": "string"
    },
    "AuditExtractionStatus": {
      "enum": [
        "validated_structured",
        "deterministically_normalised",
        "unstructured_opinion"
      ],
      "type": "string"
    },
    "AuditGenerationIdentity": {
      "properties": {
        "evidenceScope": {
          "description": "Connection observations cannot establish per-generation attribution.",
          "type": [
            "string",
            "null"
          ]
        },
        "expectedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "state",
        "transport"
      ],
      "type": "object"
    },
    "AuditLocalExecution": {
      "properties": {
        "cleanupFinishedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "stopConfirmedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "stopRequestedAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "AuditOperationState": {
      "description": "Durable operation state; `unknown` is distinct from a failed review.",
      "enum": [
        "planned",
        "dispatching",
        "accepted",
        "observed_terminal",
        "committed",
        "failed",
        "unknown"
      ],
      "type": "string"
    },
    "AuditResultExtraction": {
      "additionalProperties": false,
      "description": "Versioned deterministic extraction facts; completion provenance stays on the attempt.",
      "properties": {
        "parseDigest": {
          "type": "string"
        },
        "rawDigest": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/AuditExtractionStatus"
        },
        "transformations": {
          "items": {
            "$ref": "#/definitions/AuditResultTransformation"
          },
          "type": "array"
        },
        "validationError": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "parseDigest",
        "rawDigest",
        "status",
        "transformations",
        "version"
      ],
      "type": "object"
    },
    "AuditResultTransformation": {
      "enum": [
        "utf8_bom",
        "markdown_json_fence"
      ],
      "type": "string"
    },
    "AuditRunPhase": {
      "enum": [
        "created",
        "snapshot_bound",
        "reviewing",
        "reporting",
        "reconciling",
        "completed",
        "completed_with_failures",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "AuditRunView": {
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "cancellationRequested": {
          "type": "boolean"
        },
        "capacityReleased": {
          "description": "The operator explicitly released capacity. This is not terminal evidence.",
          "type": "boolean"
        },
        "collection": {
          "allOf": [
            {
              "$ref": "#/definitions/AuditCollectionView"
            }
          ],
          "default": {
            "completedCount": 0,
            "excludedCount": 0,
            "outstandingCount": 0,
            "ready": false,
            "reviewerCount": 0,
            "scheduling": "automatic"
          }
        },
        "observationPending": {
          "description": "A retained observation issue remains unresolved. This is non-terminal: the daemon continues observing the original operation, without resampling.",
          "type": "boolean"
        },
        "operationState": {
          "$ref": "#/definitions/AuditOperationState"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/definitions/AuditRunPhase"
        },
        "rawResult": {
          "description": "Exact retained response, including invalid JSON, when a bounded result was received.",
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewers": {
          "default": [],
          "description": "Current attempts in logical reviewer order; history uses audit/attempts.",
          "items": {
            "$ref": "#/definitions/AuditAttemptView"
          },
          "type": "array"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        }
      },
      "required": [
        "assignmentId",
        "cancellationRequested",
        "capacityReleased",
        "observationPending",
        "operationState",
        "phase",
        "revision",
        "runId",
        "snapshotId"
      ],
      "type": "object"
    },
    "AuditScheduling": {
      "enum": [
        "automatic",
        "sequential"
      ],
      "type": "string"
    }
  },
  "properties": {
    "run": {
      "$ref": "#/definitions/AuditRunView"
    }
  },
  "required": [
    "run"
  ],
  "title": "AuditReadResponse",
  "type": "object"
}